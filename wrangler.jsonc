{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ezra-apple",
  "account_id": "e87894f82403c03c5627d8e3252e4b41",
  "routes": [{ "pattern": "ezraapple.dev", "custom_domain": true }],
  "compatibility_date": "2026-05-22",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/api", "/mcp", "/llms.txt"]
  },
  "ratelimits": [
    { "name": "API_RATE_LIMIT", "namespace_id": "31001", "simple": { "limit": 300, "period": 60 } },
    { "name": "MCP_RATE_LIMIT", "namespace_id": "31002", "simple": { "limit": 120, "period": 60 } }
  ],
  "version_metadata": { "binding": "WORKER_VERSION" },
  "observability": {
    "enabled": true
  }
}
